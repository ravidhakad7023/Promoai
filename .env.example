# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# Real environment variables override values in `.env`.

# Provider: only "gemini" is implemented; add another provider in promoai/llm.py to switch.
LLM_PROVIDER=gemini

# Model id. Find the ones your key can call with:  python -m promoai.llm --list-models
# (not hard-coded on purpose: provider model names and quotas change).
LLM_MODEL=

# Your Gemini API key (create one at https://aistudio.google.com/apikey). Keep it secret.
# The variable name is <PROVIDER>_API_KEY, so it follows LLM_PROVIDER.
GEMINI_API_KEY=

# Optional tuning (defaults shown)
# LLM_TEMPERATURE=0.4            # story notes and candidate detection
# LLM_JUDGE_TEMPERATURE=0.0      # semantic judge
# LLM_JUDGE_VOTES=3              # independent judge votes; run.py uses 3 if this is unset
# LLM_MAX_OUTPUT_TOKENS=8192
# LLM_MIN_INTERVAL_SECONDS=6     # pause between calls (about 10 requests/minute)
# LLM_TIMEOUT_SECONDS=180
# LLM_MAX_TRANSPORT_RETRIES=3
# LLM_CACHE_DIR=data/cache/llm
